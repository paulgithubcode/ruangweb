---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services } from "../../data/services";
import { emailURL, whatsappURL } from "../../data/contact";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const pageURL = new URL(`/layanan/${service.slug}/`, Astro.site ?? Astro.url.origin);
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  canonicalURL={pageURL.href}
>
  <section class="service-hero">
    <div class="container">
      <a class="back-link" href="/#katalog">← Kembali ke katalog</a>

      <span class="category">{service.category}</span>

      <h1>{service.title}</h1>

      <p class="description">{service.description}</p>

      <a
        class="button"
        href={whatsappURL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Konsultasikan via WhatsApp →
      </a>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      <div class="content-grid">
        <article>
          <section class="content-block">
            <h2>Tentang Layanan Ini</h2>
            <p class="introduction">{service.introduction}</p>
          </section>

          <section class="content-block">
            <h2>Manfaat untuk Anda</h2>
            <ul>
              {service.benefits.map((benefit) => (
                <li>{benefit}</li>
              ))}
            </ul>
          </section>

          <section class="content-block">
            <h2>Fitur yang Dapat Dikembangkan</h2>
            <ul>
              {service.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </section>

          <section class="content-block">
            <h2>Pertanyaan yang Sering Diajukan</h2>

            <div class="faq-list">
              {service.faqs.map((faq) => (
                <details>
                  <summary>{faq.question}</summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        </article>

        <aside class="contact-card">
          <span class="card-label">RuangWeb</span>
          <h2>Diskusikan Proyek Anda</h2>
          <p>
            Ceritakan kebutuhan website atau aplikasi web Anda.
            Kita diskusikan solusi yang sesuai.
          </p>
          <a
            class="button"
            href={whatsappURL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Hubungi via WhatsApp →
          </a>
          <a
            class="contact-email"
            href={emailURL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Email RuangWeb
          </a>
          <a class="catalog-link" href="/#katalog">Lihat layanan lainnya</a>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    width: min(1160px, calc(100% - 48px));
    margin-inline: auto;
  }
  .service-hero {
    padding: 75px 0 85px;
    background:
      radial-gradient(ellipse at 85% 20%, #e4ebff, transparent 40%),
      linear-gradient(120deg, #fbfcff, #f4f5ff);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 38px;
    color: #5475c7;
    font-size: 14px;
    font-weight: 600;
  }

  .category {
    display: block;
    color: #4777e9;
    font-size: 13px;
    font-weight: 700;
  }

  h1 {
    margin: 13px 0;
    color: #172344;
    font-size: clamp(38px, 6vw, 58px);
    letter-spacing: -2px;
  }

  .description {
    max-width: 650px;
    color: #697895;
    font-size: 18px;
    line-height: 1.8;
  }

  .button {
    display: inline-flex;
    margin-top: 18px;
    padding: 14px 23px;
    border-radius: 999px;
    color: white;
    background: linear-gradient(110deg, #397df8, #7651ed);
    font-size: 14px;
    font-weight: 700;
  }

  .content-section {
    padding: clamp(52px, 7vw, 75px) 0;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    align-items: start;
    gap: clamp(32px, 5.5vw, 65px);
  }

  .content-block + .content-block {
    margin-top: 32px;
  }

  .content-block h2 {
    margin: 0 0 13px;
    color: #172344;
    font-size: 23px;
    letter-spacing: -.6px;
  }

  article p,
  article li {
    color: #697895;
    font-size: 15px;
    line-height: 1.8;
  }

  article ul {
    margin: 0;
    padding-left: 22px;
  }

  article li {
    padding: 4px 0;
  }

  .faq-list details {
    margin: 10px 0;
    padding: 17px 19px;
    border: 1px solid #e8edf7;
    border-radius: 13px;
  }

  .faq-list details:first-child {
    margin-top: 0;
  }

  .faq-list summary {
    color: #243454;
    font-weight: 700;
    cursor: pointer;
  }

  .faq-list details p {
    margin-bottom: 0;
  }

  .contact-card {
    position: sticky;
    top: 105px;
    padding: 27px;
    border: 1px solid #e5eaff;
    border-radius: 20px;
    background: linear-gradient(145deg, #f7f9ff, #f8f5ff);
  }

  .card-label {
    color: #4777e9;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .contact-card h2 {
    margin: 12px 0;
    font-size: 23px;
    letter-spacing: -.7px;
  }

  .contact-card p {
    color: #697895;
    font-size: 14px;
    line-height: 1.7;
  }

  .catalog-link {
    display: block;
    margin-top: 18px;
    color: #4777e9;
    font-size: 13px;
    font-weight: 700;
  }

  .contact-email {
    display: block;
    margin-top: 14px;
    color: #4777e9;
    font-size: 13px;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .contact-card {
      position: static;
    }
  }

  @media (max-width: 650px) {
    .container {
      width: min(100% - 36px, 500px);
    }

    .service-hero {
      padding: 55px 0;
    }

    .content-section {
      padding: 48px 0;
    }

    .content-block + .content-block {
      margin-top: 28px;
    }

    .content-block h2 {
      font-size: 21px;
    }

    .contact-card {
      padding: 23px;
    }
  }
</style>
