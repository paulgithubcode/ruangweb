---
import BaseLayout from "../layouts/BaseLayout.astro";
import { emailURL, whatsappURL } from "../data/contact";

const services = [
  {
    slug: "company-profile",
    icon: "▦",
    category: "Website Bisnis",
    title: "Company Profile",
    description: "Tampilkan profil, layanan, dan keunggulan bisnis secara profesional.",
    color: "blue",
    tags: "company profile profil perusahaan bisnis"
  },
  {
    slug: "personal-portfolio",
    icon: "◇",
    category: "Website Personal",
    title: "Personal Portfolio",
    description: "Bangun citra profesional dan tampilkan karya terbaik Anda.",
    color: "purple",
    tags: "portfolio personal freelancer cv"
  },
  {
    slug: "blog-portal-berita",
    icon: "▤",
    category: "Website Konten",
    title: "Blog & Portal Berita",
    description: "Publikasikan artikel, berita, dan informasi dengan pengelolaan mudah.",
    color: "mint",
    tags: "blog berita portal majalah digital"
  },
  {
    slug: "product-catalog",
    icon: "▣",
    category: "Website Bisnis",
    title: "Product Catalog",
    description: "Perkenalkan produk dengan katalog digital yang menarik dan terstruktur.",
    color: "orange",
    tags: "katalog produk product catalog"
  },
  {
    slug: "online-store",
    icon: "🛒",
    category: "Website Penjualan",
    title: "Online Store",
    description: "Mulai penjualan online dengan toko digital yang praktis.",
    color: "pink",
    tags: "toko online ecommerce e-commerce"
  },
  {
    slug: "business-information-system",
    icon: "⌘",
    category: "Aplikasi Web",
    title: "Business Information System",
    description: "Kelola proses bisnis dengan aplikasi yang sesuai kebutuhan.",
    color: "blue",
    tags: "sistem informasi aplikasi bisnis"
  },
  {
    slug: "marketplace",
    icon: "▧",
    category: "Aplikasi Web",
    title: "Marketplace",
    description: "Bangun platform yang mempertemukan penjual dan pembeli.",
    color: "purple",
    tags: "marketplace platform jual beli"
  },
  {
    slug: "custom-web-application",
    icon: "⚙",
    category: "Aplikasi Web",
    title: "Custom Web Application",
    description: "Solusi aplikasi web yang dirancang mengikuti alur kerja Anda.",
    color: "mint",
    tags: "custom aplikasi web sistem"
  }
];
---

<BaseLayout
  title="Jasa Pembuatan Website Profesional & Aplikasi Web | RuangWeb"
  description="Jasa pembuatan website profesional untuk bisnis, company profile, toko online, katalog produk, portal berita, dan aplikasi web sesuai kebutuhan."
>
    <style>
      button, input { font: inherit; }

      .container {
        width: min(1160px, calc(100% - 48px));
        margin-inline: auto;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 46px;
        padding: 0 22px;
        border: 0;
        border-radius: 999px;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px #4777e52b;
      }

      .button-primary {
        color: white;
        background: linear-gradient(110deg, #397df8, #7651ed);
      }

      .button-secondary {
        color: #315fd0;
        background: white;
        border: 1px solid #dce5ff;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 88px 0 92px;
        background:
          radial-gradient(ellipse at 78% 30%, #e2eaff 0, transparent 38%),
          radial-gradient(ellipse at 10% 100%, #f0edff 0, transparent 36%),
          linear-gradient(120deg, #fbfcff, #f5f8ff 65%, #f8f6ff);
      }

      .hero::before, .hero::after {
        content: "";
        position: absolute;
        border: 1px solid #dce7ff;
        border-radius: 50%;
        pointer-events: none;
      }

      .hero::before {
        width: 580px;
        height: 580px;
        right: -180px;
        top: -330px;
      }

      .hero::after {
        width: 420px;
        height: 420px;
        right: -90px;
        bottom: -320px;
      }

      .hero-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1.05fr .95fr;
        align-items: center;
        gap: 55px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 15px;
        border: 1px solid #e2eaff;
        border-radius: 999px;
        color: #426ac4;
        background: #ffffffbd;
        font-size: 13px;
        font-weight: 700;
      }

      .hero h1 {
        max-width: 650px;
        margin: 22px 0 18px;
        font-size: clamp(42px, 5.4vw, 66px);
        line-height: 1.08;
        letter-spacing: -3.4px;
      }

      .gradient-text {
        color: #5275ef;
        background: linear-gradient(100deg, #3488f8, #8155e9);
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-copy {
        max-width: 510px;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.8;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
      }

      .hero-visual {
        position: relative;
        min-height: 360px;
        display: grid;
        place-items: center;
      }

      .visual-glow {
        position: absolute;
        width: 330px;
        height: 280px;
        border-radius: 50%;
        background: linear-gradient(135deg, #dceaff, #e9ddff);
        filter: blur(4px);
      }

      .browser-card {
        position: relative;
        width: min(100%, 440px);
        padding: 13px;
        border: 1px solid #ffffff;
        border-radius: 20px;
        background: #ffffffd9;
        box-shadow: 0 28px 70px #607bb52b;
        transform: rotate(-3deg);
      }

      .browser-top {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 3px 5px 13px;
      }

      .browser-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #d7def0;
      }

      .browser-address {
        height: 9px;
        width: 48%;
        margin-left: 10px;
        border-radius: 9px;
        background: #edf1fa;
      }

      .mock-site {
        min-height: 245px;
        padding: 24px;
        border-radius: 12px;
        background: linear-gradient(145deg, #f2f6ff, #fff);
      }

      .mock-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .mock-logo {
        width: 72px;
        height: 12px;
        border-radius: 8px;
        background: #477af1;
      }

      .mock-menu {
        width: 100px;
        height: 8px;
        border-radius: 8px;
        background: #dce5f7;
      }

      .mock-title {
        width: 75%;
        height: 19px;
        margin-top: 42px;
        border-radius: 7px;
        background: #9bb8f5;
      }

      .mock-line {
        width: 55%;
        height: 8px;
        margin-top: 12px;
        border-radius: 8px;
        background: #d4def1;
      }

      .mock-button {
        width: 95px;
        height: 28px;
        margin-top: 20px;
        border-radius: 8px;
        background: linear-gradient(90deg, #4785f5, #8060ec);
      }

      .mock-bottom {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 28px;
      }

      .mock-bottom span {
        height: 55px;
        border-radius: 9px;
        background: #e3eaff;
      }

      .float-note {
        position: absolute;
        right: -4px;
        bottom: 42px;
        padding: 14px 17px;
        border: 1px solid white;
        border-radius: 15px;
        background: #ffffffed;
        box-shadow: 0 12px 30px #607bb522;
        color: #4f6488;
        font-size: 12px;
        font-weight: 700;
      }

      .float-note strong {
        display: block;
        margin-bottom: 4px;
        color: #315fd0;
        font-size: 14px;
      }

      .section {
        padding: 88px 0;
      }

      .section-heading {
        max-width: 660px;
        margin: 0 auto 36px;
        text-align: center;
      }

      .section-kicker {
        color: #4777e9;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .section-heading h2 {
        margin: 12px 0;
        font-size: clamp(30px, 4vw, 42px);
        letter-spacing: -1.8px;
      }

      .section-heading p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .catalog-section { background: #fff; }

      .search-wrap {
        max-width: 560px;
        margin: 0 auto 34px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 7px 8px 7px 18px;
        border: 1px solid #e5eafa;
        border-radius: 999px;
        background: white;
        box-shadow: 0 10px 35px #6279a00c;
      }

      .search-wrap input {
        flex: 1;
        min-width: 0;
        padding: 10px 0;
        border: 0;
        outline: 0;
        color: #172344;
        background: transparent;
      }

      .search-wrap input::placeholder { color: #9aa6bc; }

      .search-button {
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 50%;
        color: white;
        background: linear-gradient(135deg, #3987f8, #7456ed);
        cursor: pointer;
      }

      .service-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }

      .service-card {
        min-height: 230px;
        padding: 23px;
        border: 1px solid var(--border);
        border-radius: 19px;
        background: linear-gradient(145deg, #fff, #fbfcff);
        transition: transform .22s, box-shadow .22s, border-color .22s;
      }

      .service-card:hover {
        transform: translateY(-5px);
        border-color: #d7e3ff;
        box-shadow: 0 18px 40px #526caa16;
      }

      .service-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        font-size: 22px;
        font-weight: 700;
      }

      .blue { color: #3477ed; background: #e5efff; }
      .purple { color: #7654e9; background: #eee8ff; }
      .mint { color: #159d8b; background: #ddf8f1; }
      .orange { color: #d88926; background: #fff1d9; }
      .pink { color: #dc5b91; background: #ffebf3; }

      .service-category {
        display: block;
        margin-top: 20px;
        color: #7b8aa5;
        font-size: 11px;
        font-weight: 700;
      }

      .service-card h3 {
        margin: 6px 0 9px;
        font-size: 17px;
        letter-spacing: -.4px;
      }

      .service-card p {
        min-height: 48px;
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.65;
      }

      .card-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 16px;
        color: #386ee2;
        font-size: 13px;
        font-weight: 700;
      }

      .empty-state {
        display: none;
        padding: 30px;
        color: var(--muted);
        text-align: center;
      }

      .benefits {
        padding: 28px 0;
        background: #f7f9ff;
        border-block: 1px solid #edf1fa;
      }

      .benefit-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
      }

      .benefit {
        display: flex;
        align-items: center;
        gap: 13px;
      }

      .benefit-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        border-radius: 13px;
        color: #4779ed;
        background: white;
        font-size: 19px;
      }

      .benefit strong {
        display: block;
        font-size: 13px;
      }

      .benefit span {
        display: block;
        margin-top: 4px;
        color: var(--muted);
        font-size: 11px;
      }

      .about-grid {
        display: grid;
        grid-template-columns: .85fr 1.15fr;
        align-items: center;
        gap: 65px;
      }

      .about-panel {
        min-height: 270px;
        display: grid;
        place-items: center;
        border: 1px solid #e5eaff;
        border-radius: 25px;
        background:
          radial-gradient(circle at 50% 40%, #e3eaff, transparent 55%),
          linear-gradient(135deg, #f8faff, #f4f0ff);
      }

      .about-symbol {
        width: 112px;
        height: 112px;
        display: grid;
        place-items: center;
        border-radius: 34px;
        color: white;
        background: linear-gradient(135deg, #3988ff, #7953eb);
        box-shadow: 0 22px 45px #5875d64a;
        font-size: 60px;
        font-weight: 800;
      }

      .about-copy h2 {
        margin: 12px 0;
        font-size: 36px;
        letter-spacing: -1.5px;
      }

      .about-copy p {
        color: var(--muted);
        line-height: 1.8;
      }

      .about-points {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 13px;
        margin-top: 22px;
      }

      .about-points span {
        color: #405678;
        font-size: 13px;
        font-weight: 600;
      }

      .contact-section {
        padding: 0 0 85px;
      }

      .contact-panel {
        padding: 55px 30px;
        border: 1px solid #e4eaff;
        border-radius: 28px;
        background:
          radial-gradient(ellipse at 90% 10%, #e0e8ff, transparent 38%),
          linear-gradient(115deg, #f3f7ff, #f8f5ff);
        text-align: center;
      }

      .contact-panel h2 {
        margin: 0 0 12px;
        font-size: clamp(28px, 4vw, 39px);
        letter-spacing: -1.5px;
      }

      .contact-panel p {
        max-width: 540px;
        margin: 0 auto 25px;
        color: var(--muted);
        line-height: 1.7;
      }

      .contact-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
      }

      @media (max-width: 900px) {
        .hero-grid { grid-template-columns: 1fr 1fr; gap: 25px; }
        .service-grid { grid-template-columns: repeat(2, 1fr); }
        .benefit-grid { grid-template-columns: repeat(2, 1fr); }
        .about-grid { gap: 35px; }
      }

      @media (max-width: 650px) {
        .container { width: min(100% - 36px, 500px); }
        .hero { padding: 65px 0 55px; }
        .hero-grid { grid-template-columns: 1fr; }
        .hero h1 { font-size: 45px; letter-spacing: -2.5px; }
        .hero-copy { font-size: 15px; }
        .hero-visual { min-height: 290px; margin-top: 5px; }
        .browser-card { width: 90%; }
        .mock-site { min-height: 205px; }
        .float-note { right: 0; bottom: 15px; }
        .section { padding: 65px 0; }
        .section-heading { margin-bottom: 27px; }
        .service-grid { grid-template-columns: 1fr; gap: 13px; }
        .service-card { min-height: 0; }
        .service-card p { min-height: 0; }
        .benefit-grid { grid-template-columns: 1fr 1fr; gap: 22px 12px; }
        .benefit { align-items: flex-start; }
        .benefit-icon { width: 36px; height: 36px; }
        .about-grid { grid-template-columns: 1fr; gap: 30px; }
        .about-panel { min-height: 220px; }
        .about-copy h2 { font-size: 31px; }
        .contact-panel { padding: 42px 22px; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          scroll-behavior: auto !important;
          transition-duration: .01ms !important;
        }
      }
    </style>

      <section class="hero" id="home">
        <div class="container hero-grid">
          <div>
            <span class="eyebrow"><span aria-hidden="true">✦</span> Solusi Digital untuk Bisnis Anda</span>
            <h1>
              Jasa Pembuatan Website <span class="gradient-text">Profesional untuk Bisnis Anda.</span>
            </h1>
            <p class="hero-copy">
              Bangun kehadiran digital bisnis Anda dengan website profesional
              dan aplikasi web yang modern, responsif, mudah digunakan,
              serta dirancang sesuai kebutuhan bisnis.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#katalog">Jelajahi Katalog <span aria-hidden="true">→</span></a>
              <a class="button button-secondary" href="#tentang">Kenali RuangWeb</a>
            </div>
          </div>

          <div class="hero-visual" aria-label="Ilustrasi tampilan website modern" role="img">
            <div class="visual-glow"></div>
            <div class="browser-card">
              <div class="browser-top">
                <span class="browser-dot"></span>
                <span class="browser-dot"></span>
                <span class="browser-dot"></span>
                <span class="browser-address"></span>
              </div>
              <div class="mock-site">
                <div class="mock-nav">
                  <span class="mock-logo"></span>
                  <span class="mock-menu"></span>
                </div>
                <div class="mock-title"></div>
                <div class="mock-line"></div>
                <div class="mock-line" style="width: 40%"></div>
                <div class="mock-button"></div>
                <div class="mock-bottom"><span></span><span></span><span></span></div>
              </div>
            </div>
            <div class="float-note">
              <strong>Web Solutions</strong>
              Dirancang sesuai kebutuhan
            </div>
          </div>
        </div>
      </section>

      <section class="section catalog-section" id="katalog">
        <div class="container">
          <div class="section-heading">
            <span class="section-kicker">Katalog Layanan</span>
            <h2>Temukan Solusi <span class="gradient-text">yang Tepat</span></h2>
            <p>
              Pilih jenis website atau aplikasi web yang sesuai dengan kebutuhan
              personal maupun bisnis Anda.
            </p>
          </div>

          <label class="search-wrap">
            <span aria-hidden="true">⌕</span>
            <input
              id="service-search"
              type="search"
              placeholder="Cari layanan, misalnya toko online..."
              aria-label="Cari layanan"
            />
            <button class="search-button" type="button" aria-label="Cari">⌕</button>
          </label>

          <div class="service-grid" id="service-grid">
            {services.map((service) => (
              <article
                class="service-card"
                data-search={`${service.title} ${service.category} ${service.tags}`}
              >
                <div class={`service-icon ${service.color}`} aria-hidden="true">{service.icon}</div>
                <span class="service-category">{service.category}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <a class="card-link" href={`/layanan/${service.slug}/`}>
                  Lihat detail layanan <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
          <p class="empty-state" id="empty-state">Layanan tidak ditemukan. Coba kata kunci lain.</p>
        </div>
      </section>

      <section class="benefits" aria-label="Keunggulan layanan">
        <div class="container benefit-grid">
          <div class="benefit">
            <div class="benefit-icon" aria-hidden="true">✦</div>
            <div><strong>Desain Modern</strong><span>Tampilan bersih dan profesional</span></div>
          </div>
          <div class="benefit">
            <div class="benefit-icon" aria-hidden="true">⌁</div>
            <div><strong>Responsif</strong><span>Nyaman di berbagai perangkat</span></div>
          </div>
          <div class="benefit">
            <div class="benefit-icon" aria-hidden="true">◎</div>
            <div><strong>SEO Friendly</strong><span>Struktur ramah mesin pencari</span></div>
          </div>
          <div class="benefit">
            <div class="benefit-icon" aria-hidden="true">♡</div>
            <div><strong>Sesuai Kebutuhan</strong><span>Dibangun berdasarkan tujuan Anda</span></div>
          </div>
        </div>
      </section>

      <section class="section" id="tentang">
        <div class="container about-grid">
          <div class="about-panel" aria-hidden="true">
            <div class="about-symbol">R</div>
          </div>
          <div class="about-copy">
            <span class="section-kicker">Tentang RuangWeb</span>
            <h2>Ruang untuk Ide Anda <span class="gradient-text">Berkembang.</span></h2>
            <p>
              RuangWeb hadir untuk membantu individu dan bisnis membangun kehadiran
              digital melalui website dan aplikasi web. Kami percaya solusi yang baik
              dimulai dari memahami kebutuhan, tujuan, dan proses bisnis Anda.
            </p>
            <div class="about-points">
              <span>✓ Fokus pada kebutuhan</span>
              <span>✓ Desain mudah digunakan</span>
              <span>✓ Pengembangan terarah</span>
              <span>✓ Komunikasi yang jelas</span>
            </div>
          </div>
        </div>
      </section>

      <section class="contact-section" id="kontak">
        <div class="container">
          <div class="contact-panel">
            <span class="section-kicker">Mari Mulai</span>
            <h2>Punya Ide untuk Website Anda?</h2>
            <p>
              Ceritakan kebutuhan Anda. Mari diskusikan solusi website atau aplikasi
              web yang paling sesuai untuk bisnis Anda.
            </p>
            <div class="contact-actions">
              <a
                class="button button-primary"
                href={whatsappURL}
                target="_blank"
                rel="noopener noreferrer"
              >
                Konsultasi via WhatsApp <span aria-hidden="true">→</span>
              </a>
              <a
                class="button button-secondary"
                href={emailURL}
                target="_blank"
                rel="noopener noreferrer"
              >
                Email RuangWeb
              </a>
            </div>
          </div>
        </div>
      </section>
    <script>
      const searchInput = document.querySelector<HTMLInputElement>("#service-search");
      const serviceCards = Array.from(
        document.querySelectorAll<HTMLElement>(".service-card")
      );
      const emptyState = document.querySelector<HTMLElement>("#empty-state");

      searchInput?.addEventListener("input", () => {
        const keyword = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        serviceCards.forEach((card) => {
          const searchableText = (card.dataset.search || "").toLowerCase();
          const isMatch = searchableText.includes(keyword);

          card.hidden = !isMatch;
          if (isMatch) visibleCount++;
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? "block" : "none";
        }
      });
    </script>
</BaseLayout>
